include CHANGELOG.md CONTRIBUTING.md SECURITY.md LICENSE install.sh reposcan-run.sh
recursive-include docs *.md
recursive-include examples *.json *.md *.txt
include tools/scan_task.py tools/scan_task.sh tools/verify_wheel.py tools/verify_install.py tools/install.py
include tools/prepare_launcher.py tools/verify_launcher.py
graft tests
global-exclude *.py[cod]
prune tests/__pycache__
